{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "atshift DEFT AI authoring kit v1",
  "description": "Strict minimal input for new draft profiles, not the application's full backup format. HTML/value correspondence and rendering require application validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "profiles"],
  "properties": {
    "format": { "const": "structured-fields-prototype" },
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "text": { "type": "string", "maxLength": 50000 },
    "name": { "type": "string", "maxLength": 50000, "pattern": "\\S" },
    "key": {
      "type": "string",
      "maxLength": 50000,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "required", "value", "alt"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/name" },
        "type": { "enum": ["text", "textarea", "image", "link"] },
        "required": { "type": "boolean" },
        "value": { "$ref": "#/$defs/text" },
        "alt": { "$ref": "#/$defs/text" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "classes"],
      "properties": {
        "name": { "type": "string", "maxLength": 200, "pattern": "\\S" },
        "classes": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[^\"'<>`=]*$"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key",
        "purpose",
        "html",
        "css",
        "fields",
        "variants"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "key": { "$ref": "#/$defs/key" },
        "purpose": { "$ref": "#/$defs/text" },
        "html": { "$ref": "#/$defs/name" },
        "css": { "$ref": "#/$defs/text" },
        "fields": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/field" }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    }
  }
}
