{
  "name": "atshift-deft",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:pot": "node scripts/i18n.mjs pot",
    "i18n:compile": "node scripts/i18n.mjs compile",
    "test:i18n": "php tests/wordpress-i18n.php && node --test tests/i18n.test.mjs",
    "test:branding": "php tests/legacy-guard.php && node --test tests/branding.test.mjs",
    "test:wordpress-branding": "php tests/wordpress-branding.php",
    "test:runtime": "php tests/runtime-guard.php",
    "test:prefixes": "node --test tests/prefixes.test.mjs",
    "test:wordpress-oauth": "node --test tests/wordpress-oauth.test.mjs",
    "build:php-deps": "node scripts/build-php-deps.mjs",
    "build:wordpress": "node scripts/build-wordpress.mjs",
    "prepack:wordpress": "npm run build:wordpress",
    "pack:wordpress": "node scripts/package-wordpress.mjs",
    "pack:wordpress-org": "SF_DISTRIBUTION=wordpress-org node scripts/package-wordpress.mjs",
    "test:distribution": "node --test tests/distribution.test.mjs",
    "test:wordpress": "php tests/wordpress-integration.php",
    "test:wordpress-http": "node --test tests/wordpress-http.test.mjs",
    "test:wordpress-assets": "php tests/wordpress-assets.php && node --test tests/wordpress-assets-http.test.mjs",
    "test:wordpress-media": "php tests/wordpress-media.php && node --test tests/wordpress-media-schema.test.mjs tests/wordpress-media-http.test.mjs",
    "test:wordpress-workflow": "node --test tests/wordpress-workflow.test.mjs",
    "test:wordpress-users": "node --test tests/wordpress-users.test.mjs",
    "test:wordpress-catalog": "node --test tests/wordpress-catalog.test.mjs",
    "test:wordpress-personal": "php tests/wordpress-personal.php",
    "test:wordpress-structures": "php tests/wordpress-structures.php",
    "test:wordpress-behaviors": "php tests/wordpress-behaviors.php",
    "test:wordpress-onboarding": "php tests/wordpress-onboarding.php",
    "test:wordpress-notices": "php tests/wordpress-notices.php",
    "test:wordpress-mcp": "php tests/wordpress-connections.php && node --test tests/wordpress-mcp.test.mjs",
    "test:connection-profiles": "node --test tests/connection-profiles.test.mjs tests/mcp-adapter-guidance.test.mjs",
    "test:wordpress-publications": "php tests/wordpress-publications.php && node --test tests/wordpress-publications.test.mjs",
    "test:wordpress-security": "php tests/wordpress-security.php",
    "test:wordpress-nonces": "php tests/wordpress-nonces.php",
    "test:wordpress-oauth-inputs": "php tests/wordpress-oauth-inputs.php",
    "test:wordpress-quotas": "php tests/wordpress-quotas.php && php tests/wordpress-catalog-upgrade.php && node --test tests/wordpress-quotas-http.test.mjs",
    "test:wordpress-transport": "php tests/wordpress-transport.php",
    "build:ai-kit": "node scripts/build-ai-kit.mjs",
    "predev": "npm run build:ai-kit",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run build:ai-kit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest:kit": "npm run build:ai-kit",
    "test:kit": "node --test tests/ai-kit.test.mjs",
    "test:transport": "node --test tests/webmcp-registration.test.mjs",
    "test:server": "node --test tests/review-server.test.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10"
  }
}
